APP_NAME="مبادرة العجاونة"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Riyadh

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ajawna
DB_USERNAME=ajawna
DB_PASSWORD=
# prefer عند الاستضافة المحلية، وrequire أو verify-full مع قاعدة Postgres مُدارة تدعم TLS.
DB_SSLMODE=prefer

# مدير للتطوير المحلي فقط (database/seeders/AdminUserSeeder، لا يعمل في الإنتاج ويطبع
# رابط إعداد التحقق بخطوتين). المدير الأول في الإنتاج: php artisan admin:invite فقط.
ADMIN_NAME="اسم المدير الكامل هنا"
ADMIN_PHONE=+9665XXXXXXXX
ADMIN_PASSWORD=

# مسار لوحة الإدارة (config/admin.php). ضع في الإنتاج قيمة لا يعرفها غيرك: حروف
# لاتينية صغيرة وأرقام وشرطات فقط. فارغ = القيمة الافتراضية في config/admin.php.
# يُحجز تلقائيًا في منشئ الصفحات.
ADMIN_PATH=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# الوكلاء الموثوقون (config/trustedproxy.php). فارغان على Laravel Cloud: يُوثق بوسيطه
# تلقائيًا ويُقرأ عنوان الزائر من CF-Connecting-IP. خارجه: عناوين الوسطاء مفصولة
# بفواصل أو *، وترويسة عنوان الزائر إن كان خلف Cloudflare (none يعطّلها).
TRUSTED_PROXIES=
TRUSTED_PROXY_CLIENT_IP_HEADER=

# رؤوس الأمان (config/security.php): HSTS على الطلبات الآمنة خارج البيئة المحلية (0 يعطّله).
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=false
# للطوارئ فقط: يرسل سياسة أمان المحتوى للمراقبة دون فرضها.
CSP_REPORT_ONLY=false

# صلاحية رابط إعداد التحقق بخطوتين من php artisan admin:reset-2fa (بالدقائق).
TWO_FACTOR_SETUP_LINK_MINUTES=30

# حدود الدخول والتسجيل (config/security.php)
LOGIN_MAX_ATTEMPTS=5
LOGIN_DECAY_MINUTES=15
LOGIN_LOCKOUT_MINUTES=15
LOGIN_LOCKOUT_MAX_MINUTES=1440
LOGIN_STRIKES_RESET_HOURS=24
REGISTER_MAX_PER_IP_PER_HOUR=5
CONTACT_MAX_PER_IP_PER_HOUR=5
RECOVERY_MAX_PER_IP_PER_HOUR=5
BANK_CHANGE_ALERT_DAYS=14
TRANSFERS_DAILY_LIMIT=10
RECEIPTS_DISK=receipts
RECEIPT_LINK_MINUTES=10
RECEIPT_MAX_PIXELS=20000000
# تُحذف صور إيصالات المبادرة بعد إقفالها بهذه المدة (بالأشهر)، من التخزين ومن النسخ الاحتياطية،
# وتبقى بيانات الحوالة دائمًا (php artisan receipts:purge-expired، يوميًا).
RECEIPTS_RETENTION_MONTHS=6
BRANDING_DISK=public
BRANDING_IMAGE_MAX_KILOBYTES=2048
BRANDING_IMAGE_MAX_PIXELS=4000000
STATS_CACHE_SECONDS=60

# تخزين الإيصالات (قرص خاص): local للتطوير المحلي، أو s3 لأي bucket متوافق مع S3
# (Laravel Cloud Object Storage، Cloudflare R2، MinIO، AWS S3...) عند النشر السحابي
# (config/filesystems.php، docs/DEPLOY-NOTES.md). الإيصالات تبقى خاصة وتُعرض بروابط
# موقّعة مؤقتة دائمًا، بصرف النظر عن نوع القرص.
RECEIPTS_FILESYSTEM_DRIVER=local
# بيانات اتصال S3 مخصّصة للإيصالات؛ تُترك فارغة لاستخدام AWS_* أدناه إن كانت كافية.
RECEIPTS_AWS_ACCESS_KEY_ID=
RECEIPTS_AWS_SECRET_ACCESS_KEY=
RECEIPTS_AWS_DEFAULT_REGION=
RECEIPTS_AWS_BUCKET=
RECEIPTS_AWS_URL=
RECEIPTS_AWS_ENDPOINT=
RECEIPTS_AWS_USE_PATH_STYLE_ENDPOINT=false
RECEIPTS_AWS_ROOT=receipts

# تخزين صور الهوية (الشعار والأيقونة) وصور منشئ الصفحات (قرص عام): نفس الخيارين.
PUBLIC_FILESYSTEM_DRIVER=local
# بيانات اتصال S3 مخصّصة لهذا القرص؛ تُترك فارغة لاستخدام AWS_* أدناه إن كانت كافية.
PUBLIC_AWS_ACCESS_KEY_ID=
PUBLIC_AWS_SECRET_ACCESS_KEY=
PUBLIC_AWS_DEFAULT_REGION=
PUBLIC_AWS_BUCKET=
PUBLIC_AWS_URL=
PUBLIC_AWS_ENDPOINT=
PUBLIC_AWS_USE_PATH_STYLE_ENDPOINT=false
PUBLIC_AWS_ROOT=public

# حدود منشئ الصفحات (config/security.php)
PAGES_MAX_PAGES=50
PAGES_MAX_BLOCKS=30
PAGES_MAX_KILOBYTES=100
PAGES_MAX_MENU_ITEMS=8

# عتبات الحسابات المشبوهة (config/security.php)
SUSPICIOUS_FAILED_LOGINS=10
SUSPICIOUS_FAILED_LOGINS_HOURS=24
SUSPICIOUS_REGISTRATIONS_PER_IP=3
SUSPICIOUS_REGISTRATIONS_PER_IP_HOURS=24
SUSPICIOUS_RECOVERY_REQUESTS=3
SUSPICIOUS_RECOVERY_REQUESTS_HOURS=168

# Cloudflare Turnstile (كابتشا التسجيل واتصل بنا). المفاتيح أدناه هي مفاتيح
# Cloudflare التجريبية الرسمية العامة (تُجيز كل محاولة دائمًا)، للتطوير والاختبار
# فقط: https://developers.cloudflare.com/turnstile/troubleshooting/testing/
# استبدلها بمفاتيح حقيقية من لوحة Cloudflare في بيئة الإنتاج.
TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000AA

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

# متوافق مع Redis أو Valkey. عند خدمة مُدارة تتطلب TLS استخدم REDIS_URL بمخطط
# rediss:// (مثل rediss://user:pass@host:6379) بدل REDIS_HOST/PORT/PASSWORD أدناه.
REDIS_CLIENT=phpredis
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# لا بريد إلكتروني للمستخدمين في هذا النظام؛ القناة الوحيدة لهم واتساب يفتحه المشرف يدويًا.
# الاستثناء الوحيد: تنبيهات التشغيل إلى ALERT_EMAIL (docs/DECISIONS.md)، بلا بيانات شخصية.
# في الإنتاج: Resend عبر SMTP (بلا حزمة إضافية)، وإلا بقيت التنبيهات في السجل فقط:
#   MAIL_MAILER=smtp  MAIL_SCHEME=smtps  MAIL_HOST=smtp.resend.com  MAIL_PORT=465
#   MAIL_USERNAME=resend  MAIL_PASSWORD=<مفتاح Resend API بصلاحية Sending access فقط>
#   MAIL_FROM_ADDRESS=alerts@<الدومين الموثَّق في Resend>
# للتجربة بعد النشر: php artisan alerts:test
MAIL_MAILER=log
MAIL_SCHEME=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# مراقبة التشغيل وتنبيهاتها (config/monitoring.php). فارغ = لا تنبيهات.
ALERT_EMAIL=
ALERT_COOLDOWN_MINUTES=60
ALERT_ERROR_SPIKE_THRESHOLD=50
ALERT_ERROR_SPIKE_WINDOW_MINUTES=15
MONITOR_SCHEDULER_STALE_MINUTES=5
MONITOR_QUEUE_STALE_MINUTES=5
MONITOR_WATCHDOG_SECONDS=300
# النسخ الاحتياطي (docs/RUNBOOK.md): "غير مُعدّ" حتى التفعيل. الإيصالات الجديدة كل ساعة،
# وقاعدة البيانات يوميًا 03:00 بتوقيت الرياض. يُنبَّه عند الفشل أو التأخر أكثر من المهلة (بالساعات).
RECEIPTS_BACKUP_ENABLED=false
RECEIPTS_BACKUP_MAX_AGE_HOURS=3
DATABASE_BACKUP_ENABLED=false
DATABASE_BACKUP_MAX_AGE_HOURS=26

# وجهة النسخ الاحتياطي: bucket في Cloudflare R2 بحساب Cloudflare منفصل عن Laravel Cloud
# (config/filesystems.php القرص backups). local للتطوير فقط. لا تعود إلى AWS_* أبدًا.
BACKUP_FILESYSTEM_DRIVER=local
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
BACKUP_R2_BUCKET=
# https://<ACCOUNT_ID>.eu.r2.cloudflarestorage.com لـ bucket بنطاق الاتحاد الأوروبي
BACKUP_R2_ENDPOINT=
BACKUP_R2_REGION=auto
BACKUP_R2_USE_PATH_STYLE_ENDPOINT=true
BACKUP_R2_ROOT=
# مفتاح تشفير النسخ قبل رفعها: base64: ثم 32 بايت. يُولَّد مرة واحدة ويُحفظ خارج Laravel Cloud
# وخارج حساب Cloudflare (مدير كلمات مرور): ضياعه = استحالة استرجاع أي نسخة (docs/RUNBOOK.md).
BACKUP_ENCRYPTION_KEY=
# سياسة الاحتفاظ بنسخ قاعدة البيانات: آخر نسخة من كل يوم/أسبوع/شهر خلال هذه المدد.
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
BACKUP_KEEP_MONTHLY=6

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
