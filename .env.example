APP_NAME="مبادرة العجاونة"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Riyadh

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ajawna
DB_USERNAME=ajawna
DB_PASSWORD=

# حساب المدير الأول (يُنشئه database/seeders/AdminUserSeeder، ولا يُكرَّر عند إعادة التشغيل).
ADMIN_NAME="اسم المدير الكامل هنا"
ADMIN_PHONE=+9665XXXXXXXX
ADMIN_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# حدود الدخول والتسجيل (config/security.php)
LOGIN_MAX_ATTEMPTS=5
LOGIN_DECAY_MINUTES=15
LOGIN_LOCKOUT_MINUTES=15
LOGIN_LOCKOUT_MAX_MINUTES=1440
LOGIN_STRIKES_RESET_HOURS=24
REGISTER_MAX_PER_IP_PER_HOUR=5
BANK_CHANGE_ALERT_DAYS=14
TRANSFERS_DAILY_LIMIT=10
RECEIPTS_DISK=receipts
RECEIPT_LINK_MINUTES=10
RECEIPT_MAX_PIXELS=20000000
STATS_CACHE_SECONDS=60

# Cloudflare Turnstile (كابتشا التسجيل)
TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# لا بريد إلكتروني في هذا النظام. القناة الوحيدة هي واتساب يفتحه المشرف يدويًا.
MAIL_MAILER=log

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
