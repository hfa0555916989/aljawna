# مبادرة العجاونة — نسخة Next.js (المرحلة 1)
# انسخ هذا الملف إلى .env.local للتطوير المحلي. على Vercel تُضبط القيم من إعدادات المشروع،
# والأسرار منها بخيار Sensitive.

# رابط Postgres. على Vercel: رابط Neon المجمَّع (pooled) من تكامل Marketplace.
DATABASE_URL=postgres://ajawna:secret@127.0.0.1:5432/ajawna_next
DATABASE_POOL_MAX=3

# مدة خمول الجلسة بالدقائق.
SESSION_LIFETIME=120

# حدود الدخول والتسجيل (docs/SPEC.md §12.2, §12.3).
LOGIN_MAX_ATTEMPTS=5
LOGIN_DECAY_MINUTES=15
LOGIN_LOCKOUT_MINUTES=15
LOGIN_LOCKOUT_MAX_MINUTES=1440
LOGIN_STRIKES_RESET_HOURS=24
REGISTER_MAX_PER_IP_PER_HOUR=5

# التحقق بخطوتين لأدوار اللوحة (المرحلة 2).
TWO_FACTOR_REQUIRED=true

# Cloudflare Turnstile.
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# رؤوس الأمان.
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=false
CSP_REPORT_ONLY=false

# خارج Vercel فقط: رأس عنوان الزائر من وسيط موثوق (على Vercel يُقرأ x-real-ip تلقائيًا).
TRUSTED_CLIENT_IP_HEADER=
